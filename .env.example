# ---------------------------------------------------------------------------
# Public client configuration. Anything prefixed with VITE_ is shipped to the
# browser bundle, so never put credentials or keys in a VITE_ variable.
# ---------------------------------------------------------------------------

# Optional token data. Leave blank until the verified TSUN Solana mint exists.
VITE_TSUN_TOKEN_ADDRESS=

# Optional: pin a specific Solana liquidity pair instead of the deepest pair.
VITE_TSUN_PAIR_ADDRESS=

# ---------------------------------------------------------------------------
# Server side model link for TALK TO TSUN. These are read by the /api/chat
# handler only (vite.config.ts in dev and preview, api/chat.ts in production),
# never by the browser bundle. OpenRouter is tried first, Gemini is the
# fallback, and the local character engine answers if neither is reachable.
# ---------------------------------------------------------------------------

# Primary provider. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Defaults to a current mid-size open model.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# Optional comma separated chain used for OpenRouter routing and retries.
OPENROUTER_FALLBACK_MODELS=x-ai/grok-4-fast,google/gemini-2.5-flash
# Optional attribution headers shown on the OpenRouter dashboard.
OPENROUTER_SITE_URL=

# Fallback provider. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to the current stable Flash model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Optional gateway overrides, useful for proxies or self hosted endpoints.
# OPENROUTER_BASE_URL=
# GEMINI_BASE_URL=
