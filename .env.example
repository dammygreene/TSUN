# TSUN configuration. Everything integration related is optional and env gated.
# The app must run with zero keys and degrade to honest UNAVAILABLE states.

# Token config (never hard code). Until a real mint is supplied the token is NOT CONFIGURED.
NEXT_PUBLIC_TSUN_MINT=
NEXT_PUBLIC_TSUN_PAIR=TSUN/SOL
NEXT_PUBLIC_TSUN_SUPPLY=
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_EXPLORER_URL=https://solscan.io

# Market data providers (server side). Leave empty for deterministic offline fallback.
# COINGECKO_API_KEY=
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=

# Optional LLM adapter. When unset, the deterministic local character engine is used.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TSUN_LLM_PROVIDER=none

# Posting / workers (post MVP stage 9 only)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
